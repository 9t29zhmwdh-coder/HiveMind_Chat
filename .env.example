# Copy to .env and fill in. Never commit the filled-in file.
#
# HiveMind Chat stores only the NAME of an environment variable in its config,
# never a key. The values below are read at request time and are not written to
# the database or to hivemind.toml.

# Shared access token. Required whenever the server is reachable from the
# network; leave empty only for a loopback-only instance.
HIVEMIND_ACCESS_TOKEN=

# Cloud credentials, referenced from hivemind.toml via api_key_env.
# Add one variable per account you want in a room.
HIVEMIND_KEY_ANTHROPIC=
HIVEMIND_KEY_OPENAI=
HIVEMIND_KEY_GROQ=

# Log level: error, warn, info, debug, trace
RUST_LOG=info
